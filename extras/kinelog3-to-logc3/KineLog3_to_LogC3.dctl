// KineLog3 / Kinefinity Wide Gamut  ->  ARRI LogC3 / ARRI Wide Gamut 3
// Kinefinity MAVO Edge 6K -> ARRI ALEXA Mini LF
//
// Part of Color Space Transform mk2 (extras). Built from Kinefinity's "KineLog3 Technical Specifications" v2 PDF
// and ARRI's LogC3 (SUP 3.x) / AWG3 specification. Generated by kl3_logc3.py.
// Input : KineLog3 / KWG (camera-original, no other transforms before this node)
// Output: ARRI LogC3 / AWG3 at the chosen EI -> feed straight into any ALEXA LogC3 LUT/CST.
// 
// clang-format off
DEFINE_UI_PARAMS(ei, LogC3 EI, DCTLUI_COMBO_BOX, 7, {EI160, EI200, EI250, EI320, EI400, EI500, EI640, EI800, EI1000, EI1280, EI1600}, {EI 160, EI 200, EI 250, EI 320, EI 400, EI 500, EI 640, EI 800, EI 1000, EI 1280, EI 1600})
DEFINE_UI_PARAMS(use_cm, Chart Match, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(cm_mix, Chart Match Amount, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(exposure, Exposure Trim (stops), DCTLUI_SLIDER_FLOAT, 0.0, -3.0, 3.0, 0.01)
// clang-format on

__DEVICE__ float kl3_to_lin(float v) {
    const float a = 66.64f, b = 0.296f, c = 0.907136f, d = 0.092864f;
    const float cut = -0.008239f, s = 0.017178f;
    return v < 0.0f ? v * s + cut : (_exp10f(((v - d) / b) / c) - 1.0f) / a;
}

__DEVICE__ float lin_to_logc3(float x, int ei_idx) {
    float cut, a, b, c, d, e, f;
    if (ei_idx == EI160) { cut=0.005561f; a=5.555556f; b=0.080216f; c=0.269036f; d=0.381991f; e=5.842037f; f=0.092778f; }
    else if (ei_idx == EI200) { cut=0.006208f; a=5.555556f; b=0.076621f; c=0.266007f; d=0.382478f; e=5.776265f; f=0.092782f; }
    else if (ei_idx == EI250) { cut=0.006871f; a=5.555556f; b=0.072941f; c=0.262978f; d=0.382966f; e=5.710494f; f=0.092786f; }
    else if (ei_idx == EI320) { cut=0.007622f; a=5.555556f; b=0.068768f; c=0.259627f; d=0.383508f; e=5.637732f; f=0.092791f; }
    else if (ei_idx == EI400) { cut=0.008318f; a=5.555556f; b=0.064901f; c=0.256598f; d=0.383999f; e=5.57196f; f=0.092795f; }
    else if (ei_idx == EI500) { cut=0.009031f; a=5.555556f; b=0.060939f; c=0.253569f; d=0.384493f; e=5.506188f; f=0.0928f; }
    else if (ei_idx == EI640) { cut=0.00984f; a=5.555556f; b=0.056443f; c=0.250219f; d=0.38504f; e=5.433426f; f=0.092805f; }
    else if (ei_idx == EI800) { cut=0.010591f; a=5.555556f; b=0.052272f; c=0.24719f; d=0.385537f; e=5.367655f; f=0.092809f; }
    else if (ei_idx == EI1000) { cut=0.011361f; a=5.555556f; b=0.047996f; c=0.244161f; d=0.386036f; e=5.301883f; f=0.092814f; }
    else if (ei_idx == EI1280) { cut=0.012235f; a=5.555556f; b=0.043137f; c=0.24081f; d=0.38659f; e=5.229121f; f=0.092819f; }
    else if (ei_idx == EI1600) { cut=0.013047f; a=5.555556f; b=0.038625f; c=0.237781f; d=0.387093f; e=5.16335f; f=0.092824f; }
    else { cut=0.010591f; a=5.555556f; b=0.052272f; c=0.247190f; d=0.385537f; e=5.367655f; f=0.092809f; }
    return x > cut ? c * _log10f(a * x + b) + d : e * x + f;
}

__DEVICE__ float sqrt0(float x) { return _sqrtf(_fmaxf(x, 0.0f)); }

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    // KWG -> AWG3 (both D65, derived from published primaries)
    const float m[3][3] = {
        {1.1280040887f, -0.0914739309f, -0.0365301578f},
        {-0.1480259889f, 1.2915477729f, -0.1435217839f},
        {0.0002405715f, -0.2150593460f, 1.2148187745f}
    };
    // Chart-match model, root-polynomial (r, g, b, sqrt(rg), sqrt(gb), sqrt(rb)) in linear AWG3.
    // Identity unless generated by `kl3_logc3.py match`.
    const float cm[3][6] = {
        {1.0000000000f, 0.0000000000f, 0.0000000000f, 0.0000000000f, 0.0000000000f, 0.0000000000f},
        {0.0000000000f, 1.0000000000f, 0.0000000000f, 0.0000000000f, 0.0000000000f, 0.0000000000f},
        {0.0000000000f, 0.0000000000f, 1.0000000000f, 0.0000000000f, 0.0000000000f, 0.0000000000f}
    };

    float r = kl3_to_lin(p_R), g = kl3_to_lin(p_G), b = kl3_to_lin(p_B);

    float R = m[0][0] * r + m[0][1] * g + m[0][2] * b;
    float G = m[1][0] * r + m[1][1] * g + m[1][2] * b;
    float B = m[2][0] * r + m[2][1] * g + m[2][2] * b;

    if (use_cm) {
        float f[6] = {R, G, B, sqrt0(R * G), sqrt0(G * B), sqrt0(R * B)};
        float o[3];
        for (int i = 0; i < 3; i++) {
            o[i] = 0.0f;
            for (int j = 0; j < 6; j++) o[i] += cm[i][j] * f[j];
        }
        R = R + cm_mix * (o[0] - R);
        G = G + cm_mix * (o[1] - G);
        B = B + cm_mix * (o[2] - B);
    }

    float k = _exp2f(exposure);
    int ei_sel = (int)ei;
    return make_float3(lin_to_logc3(R * k, ei_sel), lin_to_logc3(G * k, ei_sel), lin_to_logc3(B * k, ei_sel));
}
